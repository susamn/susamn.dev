---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await project.render();

// Get related projects
const allProjects = await getCollection('projects');
const relatedProjects = allProjects
	.filter(p => p.slug !== project.slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title={`${project.data.title} | Projects | Supratim Samanta`} description={project.data.description}>
	<article class="max-w-none">
		<!-- Project Header -->
		<header class="mb-10">
			<a href="/projects" class="inline-flex items-center gap-2 text-sm font-medium text-stone-400 hover:text-amber-600 transition-colors mb-6">
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
				</svg>
				Back to Projects
			</a>
			
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
				<div class="flex-1">
					<div class="flex items-center gap-4 mb-4">
						<span class="text-sm font-medium text-amber-600 uppercase tracking-wider">Project Case Study</span>
						<div class="flex-1 h-px bg-stone-200"></div>
					</div>
					<h1 class="font-['Fraunces',_serif] text-4xl md:text-5xl font-semibold text-stone-900 leading-tight mb-4">
						{project.data.title}
					</h1>
					<p class="text-xl text-stone-500 leading-relaxed max-w-3xl">
						{project.data.description}
					</p>
				</div>
				
				<div class="flex flex-wrap gap-3">
					{project.data.github && (
						<a
							href={project.data.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-5 py-2.5 bg-stone-900 text-white rounded-lg font-medium hover:bg-stone-800 transition-all shadow-md hover:shadow-lg"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.11.81 2.235 0 1.62-.015 2.925-.015 3.315 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
							View Source
						</a>
					)}
					{project.data.link && (
						<a
							href={project.data.link}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-600 text-white rounded-lg font-medium hover:bg-amber-700 transition-all shadow-md hover:shadow-lg"
						>
							Live Demo
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
							</svg>
						</a>
					)}
				</div>
			</div>

			<div class="flex flex-wrap gap-2 mb-10">
				{project.data.tags.map(tag => (
					<span class="px-3 py-1 bg-stone-100 text-stone-600 text-sm font-medium rounded-full border border-stone-200">
						{tag}
					</span>
				))}
			</div>
		</header>

		<!-- Project Content -->
		<div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
			<div class="prose prose-stone prose-lg max-w-none p-6 md:p-12
				prose-headings:font-['Fraunces',_serif] prose-headings:font-semibold prose-headings:text-stone-900
				prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b prose-h2:border-stone-100
				prose-h3:text-2xl prose-h3:mt-10 prose-h3:mb-4
				prose-h4:text-xl prose-h4:mt-8 prose-h4:mb-3
				prose-p:text-stone-600 prose-p:leading-relaxed prose-p:mb-6
				prose-a:text-amber-600 prose-a:no-underline hover:prose-a:text-amber-700 prose-a:font-medium
				prose-strong:text-stone-800 prose-strong:font-semibold
				prose-code:text-amber-700 prose-code:bg-amber-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-normal
				prose-pre:bg-stone-900 prose-pre:rounded-xl prose-pre:my-8 prose-pre:shadow-lg
				prose-blockquote:border-l-amber-400 prose-blockquote:bg-amber-50/50 prose-blockquote:rounded-r-lg prose-blockquote:py-2 prose-blockquote:not-italic
				prose-img:rounded-2xl prose-img:shadow-xl prose-img:my-12
				prose-hr:border-stone-200 prose-hr:my-12">
				<Content />
			</div>
		</div>

		<!-- Project Footer -->
		<footer class="mt-12 p-8 bg-stone-50 rounded-2xl border border-stone-200">
			<div class="flex flex-col md:flex-row items-center justify-between gap-8">
				<div>
					<h3 class="font-['Fraunces',_serif] text-xl font-semibold text-stone-900 mb-2">Interested in this project?</h3>
					<p class="text-stone-500">Feel free to reach out if you have questions or want to collaborate.</p>
				</div>
				<div class="flex gap-4">
					<a href="/about" class="px-6 py-2.5 bg-white text-stone-700 border border-stone-200 rounded-lg font-medium hover:bg-stone-50 transition-colors">About Me</a>
					<a href="https://github.com/susamn" class="px-6 py-2.5 bg-stone-900 text-white rounded-lg font-medium hover:bg-stone-800 transition-colors">Follow on GitHub</a>
				</div>
			</div>
		</footer>
	</article>

	<!-- More Projects -->
	{relatedProjects.length > 0 && (
		<section class="mt-20">
			<div class="flex items-center gap-4 mb-8">
				<h2 class="font-['Fraunces',_serif] text-2xl font-semibold text-stone-800">More Projects</h2>
				<div class="flex-1 h-px bg-stone-200"></div>
				<a href="/projects" class="text-sm font-medium text-amber-700 hover:text-amber-800 transition-colors uppercase tracking-wide">View all</a>
			</div>
			<div class="grid md:grid-cols-3 gap-6">
				{relatedProjects.map((relProject) => (
					<a
						href={`/projects/${relProject.slug}`}
						class="group bg-white rounded-xl border border-stone-200 p-6 hover:border-amber-300 hover:shadow-lg transition-all duration-200"
					>
						<div class="flex flex-wrap gap-1.5 mb-3">
							{relProject.data.tags.slice(0, 2).map(tag => (
								<span class="text-[10px] font-semibold text-stone-400 bg-stone-100 px-2 py-0.5 rounded uppercase tracking-wider">
									{tag}
								</span>
							))}
						</div>
						<h3 class="font-['Fraunces',_serif] text-lg font-semibold text-stone-900 group-hover:text-amber-700 transition-colors leading-snug mb-2">
							{relProject.data.title}
						</h3>
						<p class="text-sm text-stone-500 line-clamp-2 leading-relaxed">
							{relProject.data.description}
						</p>
					</a>
				))}
			</div>
		</section>
	)}
</Layout>
